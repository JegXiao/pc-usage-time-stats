<Window x:Class="ComputerUsageStats.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用统计"
        Width="520" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DetailBgBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="DetailBgBrush" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="BarBrush" Color="#3D7EF5"/>
        <SolidColorBrush x:Key="BarRestBrush" Color="#E4E6EA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B6B"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="使用统计" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            
        </Grid>

        <!-- 三个 Tab -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="18"
                Padding="4" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TabTodayBg" Background="#E8EAEE" CornerRadius="14" Padding="0,8"
                        MouseLeftButtonDown="TabToday_Click" Cursor="Hand">
                    <TextBlock x:Name="TabTodayText" Text="今天" TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <Border Grid.Column="1" x:Name="TabWeekBg" Background="Transparent" CornerRadius="14" Padding="0,8"
                        MouseLeftButtonDown="TabWeek_Click" Cursor="Hand">
                    <TextBlock x:Name="TabWeekText" Text="过去7天" TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource SubTextBrush}"/>
                </Border>
                <Border Grid.Column="2" x:Name="TabMonthBg" Background="Transparent" CornerRadius="14" Padding="0,8"
                        MouseLeftButtonDown="TabMonth_Click" Cursor="Hand">
                    <TextBlock x:Name="TabMonthText" Text="过去30天" TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource SubTextBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 摘要 + 图表 -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SummaryMain" Text="0 分钟" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="SummarySub" Text="" FontSize="12"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,10"/>
                        <TextBlock x:Name="PeakHint" Text="" FontSize="11" Foreground="#FF6B6B"
                                   Margin="0,0,0,8"/>
                        <Canvas x:Name="ChartCanvas" Height="160" HorizontalAlignment="Stretch"/>
                        <Canvas x:Name="ChartLabels" Height="22" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 应用排行 -->
                <TextBlock Text="应用使用排行" FontSize="13" Foreground="{DynamicResource SubTextBrush}"
                           Margin="8,0,0,8"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="16,8" Margin="0,0,0,12">
                    <StackPanel x:Name="RankingList"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="数据每30秒自动保存 · 右键小组件可退出程序"
                   FontSize="10" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</Window>
