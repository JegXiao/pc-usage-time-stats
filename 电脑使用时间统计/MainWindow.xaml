<Window x:Class="ComputerUsageStats.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="电脑使用时间统计"
        Icon="app.ico"
        Width="340" Height="440"
        WindowStartupLocation="Manual" Left="80" Top="80"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="RingRestBrush" Color="#E8E8E8"/>
        <!-- 覆盖系统按钮默认样式（否则深色模式下按钮是浅色块） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.15"/>
                                <Setter TargetName="bg" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="24" Padding="24,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 顶部：日期导航 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="PrevButton" Content="‹" Click="PrevDate_Click"
                        FontSize="16" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource SubTextBrush}" Cursor="Hand"
                        Width="26" Height="26" Padding="0"/>
                <TextBlock x:Name="DateText" Text="今天" FontSize="13"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="4,0,4,0"/>
                <Button x:Name="NextButton" Content="›" Click="NextDate_Click"
                        FontSize="16" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource SubTextBrush}" Cursor="Hand"
                        Width="26" Height="26" Padding="0"/>
            </StackPanel>

            <!-- 总时长 + 圆环 -->
            <Grid Grid.Row="1" Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TotalTextTop" Text="0 分钟" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="TotalTextBottom" Text="" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <Canvas x:Name="RingCanvas" Grid.Column="1" Width="110" Height="110"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- 应用列表 -->
            <StackPanel x:Name="AppList" Grid.Row="2"/>

            <!-- 底部 -->
            <TextBlock Grid.Row="3" Text="健康使用电脑" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <!-- 大小调节模式的覆盖层：虚线边框 + 八个方向的拖拽柄 -->
            <Grid x:Name="ResizeOverlay" Visibility="Collapsed" Grid.RowSpan="4" Margin="-20,-18,-20,-18">
                <Rectangle Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5"
                           StrokeDashArray="4 3" Opacity="0.9" RadiusX="26" RadiusY="26"/>
                <Thumb x:Name="GripN" Tag="N" DragDelta="Grip_DragDelta" Cursor="SizeNS"
                       Height="10" VerticalAlignment="Top" Background="Transparent"/>
                <Thumb x:Name="GripS" Tag="S" DragDelta="Grip_DragDelta" Cursor="SizeNS"
                       Height="10" VerticalAlignment="Bottom" Background="Transparent"/>
                <Thumb x:Name="GripW" Tag="W" DragDelta="Grip_DragDelta" Cursor="SizeWE"
                       Width="10" HorizontalAlignment="Left" Background="Transparent"/>
                <Thumb x:Name="GripE" Tag="E" DragDelta="Grip_DragDelta" Cursor="SizeWE"
                       Width="10" HorizontalAlignment="Right" Background="Transparent"/>
                <Thumb Tag="NW" DragDelta="Grip_DragDelta" Cursor="SizeNWSE"
                       Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"/>
                <Thumb Tag="NE" DragDelta="Grip_DragDelta" Cursor="SizeNESW"
                       Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"/>
                <Thumb Tag="SW" DragDelta="Grip_DragDelta" Cursor="SizeNESW"
                       Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"/>
                <Thumb Tag="SE" DragDelta="Grip_DragDelta" Cursor="SizeNWSE"
                       Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"/>
            </Grid>

            <!-- 进入/退出大小调节模式的小按钮（角落，低对比，防误触） -->
            <Button x:Name="ResizeButton" Grid.RowSpan="4"
                    Content="⤢" FontSize="11" Padding="0"
                    Width="20" Height="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,4,4"
                    Background="Transparent" Foreground="{DynamicResource SubTextBrush}"
                    BorderThickness="0" Opacity="0.4" Cursor="Hand"
                    ToolTip="调整大小"
                    Click="ResizeMode_Click"/>

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="详细统计" Click="Detail_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Border>
</Window>
